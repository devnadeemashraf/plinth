{
  "components": {
    "schemas": {
      "ProblemDetails": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "status": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Plinth API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/livez": {
      "get": {
        "description": "Answers 200 while the process can serve requests. Checks no dependency.",
        "operationId": "get_livez",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                },
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "const": "ok",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Alive"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Runs every module's readiness checks in parallel, each limited to 1 s. Answers 503 with the failing check names while any fails.",
        "operationId": "get_readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "checks": {
                    "database": "ok"
                  },
                  "status": "ready"
                },
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "checks": {
                      "additionalProperties": {
                        "const": "ok",
                        "type": "string"
                      },
                      "propertyNames": {
                        "type": "string"
                      },
                      "type": "object"
                    },
                    "status": {
                      "const": "ready",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "checks"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Every dependency is reachable"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "failing": [
                    "database"
                  ],
                  "status": "unready"
                },
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "failing": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "status": {
                      "const": "unready",
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "failing"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "At least one dependency is unreachable"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
