{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "types": ["node"],
    "paths": {
      "@plinth/core": ["./src/index.ts"],
      "@plinth/core/*": ["./src/*"],
      "@/*": ["./src/*"],
      "#/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
