{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@plinth/core": ["../../core/dist/src/index.d.ts"],
      "@plinth/core/*": ["../../core/dist/src/*"],
      "@plinth/modules-admin": ["./src/index.ts"],
      "@plinth/modules-admin/*": ["./src/*"],
      "@/*": ["./src/*"],
      "#/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "../../core" },
    { "path": "../brand" },
    { "path": "../config-store" },
    { "path": "../rbac" },
    { "path": "../tenants" },
    { "path": "../auth" },
    { "path": "../audit" },
    { "path": "../billing" }
  ],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
