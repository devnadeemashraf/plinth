{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@plinth/core": ["../../core/dist/src/index.d.ts"],
      "@plinth/core/*": ["../../core/dist/src/*"],
      "@plinth/modules-audit": ["../audit/dist/src/index.d.ts"],
      "@plinth/modules-audit/*": ["../audit/dist/src/*"],
      "@plinth/modules-config-store": ["../config-store/dist/src/index.d.ts"],
      "@plinth/modules-config-store/*": ["../config-store/dist/src/*"],
      "@plinth/modules-auth": ["./src/index.ts"],
      "@plinth/modules-auth/*": ["./src/*"],
      "@/*": ["./src/*"],
      "#/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../../core" }, { "path": "../audit" }, { "path": "../config-store" }],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
