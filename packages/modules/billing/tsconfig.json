{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@plinth/core": ["../../core/dist/src/index.d.ts"],
      "@plinth/core/*": ["../../core/dist/src/*"],
      "@plinth/adapter-db-sqlite": ["../../adapter-db-sqlite/dist/src/index.d.ts"],
      "@plinth/adapter-db-sqlite/*": ["../../adapter-db-sqlite/dist/src/*"],
      "@plinth/adapter-billing-stub": ["../../adapter-billing-stub/dist/src/index.d.ts"],
      "@plinth/adapter-billing-stub/*": ["../../adapter-billing-stub/dist/src/*"],
      "@plinth/modules-billing": ["./src/index.ts"],
      "@plinth/modules-billing/*": ["./src/*"],
      "@/*": ["./src/*"],
      "#/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "../../core" },
    { "path": "../../adapter-db-sqlite" },
    { "path": "../../adapter-billing-stub" }
  ],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
