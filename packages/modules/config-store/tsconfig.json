{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@plinth/core": ["../../core/dist/src/index.d.ts"],
      "@plinth/core/*": ["../../core/dist/src/*"],
      "@plinth/modules-config-store": ["./src/index.ts"],
      "@plinth/modules-config-store/*": ["./src/*"],
      "@/*": ["./src/*"],
      "#/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../../core" }],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
