{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@plinth/core": ["./packages/core/src/index.ts"],
      "@plinth/core/*": ["./packages/core/src/*"],
      "@plinth/modules-brand": ["./packages/modules/brand/src/index.ts"],
      "@plinth/modules-brand/*": ["./packages/modules/brand/src/*"],
      "@plinth/modules-tenants": ["./packages/modules/tenants/src/index.ts"],
      "@plinth/modules-tenants/*": ["./packages/modules/tenants/src/*"],
      "@plinth/modules-rbac": ["./packages/modules/rbac/src/index.ts"],
      "@plinth/modules-rbac/*": ["./packages/modules/rbac/src/*"],
      "@plinth/modules-config-store": ["./packages/modules/config-store/src/index.ts"],
      "@plinth/modules-config-store/*": ["./packages/modules/config-store/src/*"],
      "@plinth/modules-audit": ["./packages/modules/audit/src/index.ts"],
      "@plinth/modules-audit/*": ["./packages/modules/audit/src/*"],
      "@plinth/modules-auth": ["./packages/modules/auth/src/index.ts"],
      "@plinth/modules-auth/*": ["./packages/modules/auth/src/*"],
      "@plinth/contract-tests": ["./packages/contract-tests/src/index.ts"],
      "@plinth/contract-tests/*": ["./packages/contract-tests/src/*"],
      "@plinth/adapter-http-fastify": ["./packages/adapter-http-fastify/src/index.ts"],
      "@plinth/adapter-http-fastify/*": ["./packages/adapter-http-fastify/src/*"],
      "@plinth/adapter-http-express": ["./packages/adapter-http-express/src/index.ts"],
      "@plinth/adapter-http-express/*": ["./packages/adapter-http-express/src/*"],
      "@plinth/adapter-db-sqlite": ["./packages/adapter-db-sqlite/src/index.ts"],
      "@plinth/adapter-db-sqlite/*": ["./packages/adapter-db-sqlite/src/*"],
      "@plinth/adapter-db-postgres": ["./packages/adapter-db-postgres/src/index.ts"],
      "@plinth/adapter-db-postgres/*": ["./packages/adapter-db-postgres/src/*"],
      "@plinth/adapter-db-mysql": ["./packages/adapter-db-mysql/src/index.ts"],
      "@plinth/adapter-db-mysql/*": ["./packages/adapter-db-mysql/src/*"],
      "@plinth/reference-api": ["./apps/reference-api/src/app.ts"],
      "@plinth/reference-api/*": ["./apps/reference-api/src/*"],
      "@/*": ["./packages/core/src/*"],
      "#/*": ["./packages/core/src/*"]
    }
  }
}
