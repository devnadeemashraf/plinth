{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@plinth/core": ["./packages/core/src/index.ts"],
      "@plinth/core/*": ["./packages/core/src/*"],
      "@plinth/modules-brand": ["./packages/modules/brand/src/index.ts"],
      "@plinth/modules-brand/*": ["./packages/modules/brand/src/*"],
      "@plinth/modules-tenants": ["./packages/modules/tenants/src/index.ts"],
      "@plinth/modules-tenants/*": ["./packages/modules/tenants/src/*"],
      "@plinth/modules-rbac": ["./packages/modules/rbac/src/index.ts"],
      "@plinth/modules-rbac/*": ["./packages/modules/rbac/src/*"],
      "@plinth/modules-config-store": ["./packages/modules/config-store/src/index.ts"],
      "@plinth/modules-config-store/*": ["./packages/modules/config-store/src/*"],
      "@plinth/modules-audit": ["./packages/modules/audit/src/index.ts"],
      "@plinth/modules-audit/*": ["./packages/modules/audit/src/*"],
      "@plinth/modules-auth": ["./packages/modules/auth/src/index.ts"],
      "@plinth/modules-auth/*": ["./packages/modules/auth/src/*"],
      "@plinth/contract-tests": ["./packages/contract-tests/src/index.ts"],
      "@plinth/contract-tests/*": ["./packages/contract-tests/src/*"],
      "@plinth/adapter-http-fastify": ["./packages/adapters/http/fastify/src/index.ts"],
      "@plinth/adapter-http-fastify/*": ["./packages/adapters/http/fastify/src/*"],
      "@plinth/adapter-http-express": ["./packages/adapters/http/express/src/index.ts"],
      "@plinth/adapter-http-express/*": ["./packages/adapters/http/express/src/*"],
      "@plinth/adapter-db-sqlite": ["./packages/adapters/db/sqlite/src/index.ts"],
      "@plinth/adapter-db-sqlite/*": ["./packages/adapters/db/sqlite/src/*"],
      "@plinth/adapter-db-postgres": ["./packages/adapters/db/postgres/src/index.ts"],
      "@plinth/adapter-db-postgres/*": ["./packages/adapters/db/postgres/src/*"],
      "@plinth/adapter-db-mysql": ["./packages/adapters/db/mysql/src/index.ts"],
      "@plinth/adapter-db-mysql/*": ["./packages/adapters/db/mysql/src/*"],
      "@plinth/adapter-cache-memory": ["./packages/adapters/cache/memory/src/index.ts"],
      "@plinth/adapter-cache-memory/*": ["./packages/adapters/cache/memory/src/*"],
      "@plinth/adapter-cache-redis": ["./packages/adapters/cache/redis/src/index.ts"],
      "@plinth/adapter-cache-redis/*": ["./packages/adapters/cache/redis/src/*"],
      "@plinth/adapter-queue-db": ["./packages/adapters/queue/db/src/index.ts"],
      "@plinth/adapter-queue-db/*": ["./packages/adapters/queue/db/src/*"],
      "@plinth/adapter-queue-bullmq": ["./packages/adapters/queue/bullmq/src/index.ts"],
      "@plinth/adapter-queue-bullmq/*": ["./packages/adapters/queue/bullmq/src/*"],
      "@plinth/adapter-email-stub": ["./packages/adapters/email/stub/src/index.ts"],
      "@plinth/adapter-email-stub/*": ["./packages/adapters/email/stub/src/*"],
      "@plinth/adapter-email-smtp": ["./packages/adapters/email/smtp/src/index.ts"],
      "@plinth/adapter-email-smtp/*": ["./packages/adapters/email/smtp/src/*"],
      "@plinth/adapter-storage-local": ["./packages/adapters/storage/local/src/index.ts"],
      "@plinth/adapter-storage-local/*": ["./packages/adapters/storage/local/src/*"],
      "@plinth/adapter-storage-s3": ["./packages/adapters/storage/s3/src/index.ts"],
      "@plinth/adapter-storage-s3/*": ["./packages/adapters/storage/s3/src/*"],
      "@plinth/adapter-analytics-stub": ["./packages/adapters/analytics/stub/src/index.ts"],
      "@plinth/adapter-analytics-stub/*": ["./packages/adapters/analytics/stub/src/*"],
      "@plinth/adapter-billing-stub": ["./packages/adapters/billing/stub/src/index.ts"],
      "@plinth/adapter-billing-stub/*": ["./packages/adapters/billing/stub/src/*"],
      "@plinth/adapter-billing-razorpay": ["./packages/adapters/billing/razorpay/src/index.ts"],
      "@plinth/adapter-billing-razorpay/*": ["./packages/adapters/billing/razorpay/src/*"],
      "@plinth/adapter-billing-stripe": ["./packages/adapters/billing/stripe/src/index.ts"],
      "@plinth/adapter-billing-stripe/*": ["./packages/adapters/billing/stripe/src/*"],
      "@plinth/modules-users": ["./packages/modules/users/src/index.ts"],
      "@plinth/modules-users/*": ["./packages/modules/users/src/*"],
      "@plinth/modules-compliance": ["./packages/modules/compliance/src/index.ts"],
      "@plinth/modules-compliance/*": ["./packages/modules/compliance/src/*"],
      "@plinth/modules-billing": ["./packages/modules/billing/src/index.ts"],
      "@plinth/modules-billing/*": ["./packages/modules/billing/src/*"],
      "@plinth/modules-admin": ["./packages/modules/admin/src/index.ts"],
      "@plinth/modules-admin/*": ["./packages/modules/admin/src/*"],
      "@plinth/cli": ["./packages/cli/src/index.ts"],
      "@plinth/cli/*": ["./packages/cli/src/*"],
      "@plinth/reference-api": ["./apps/reference-api/src/app.ts"],
      "@plinth/reference-api/*": ["./apps/reference-api/src/*"],
      "@/*": ["./packages/core/src/*"],
      "#/*": ["./packages/core/src/*"]
    }
  }
}
