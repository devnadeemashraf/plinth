{
  "name": "plinth",
  "version": "0.0.0",
  "private": true,
  "description": "Production-ready TypeScript backend template.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.13.1"
  },
  "imports": {
    "#platform/*": "./src/platform/*",
    "#modules/*": "./src/modules/*"
  },
  "scripts": {
    "brief": "node scripts/kit/brief.ts",
    "check": "node scripts/kit/check.ts",
    "fmt": "biome check --write .",
    "map": "node scripts/kit/map.ts",
    "docs": "node scripts/kit/docs.ts",
    "doctor": "node scripts/kit/doctor.ts",
    "openapi": "node scripts/openapi.ts",
    "openapi:check": "node scripts/openapi.ts --check",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@scalar/api-reference": "1.77.0",
    "awilix": "13.0.5",
    "express": "5.3.0",
    "pino": "10.4.0",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  }
}
