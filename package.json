{
  "name": "plinth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @plinth/reference-api dev",
    "start": "pnpm --filter @plinth/reference-api start",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:fitness": "vitest run packages/core/test/fitness/architecture.test.ts",
    "test:core": "vitest run packages/core",
    "test:modules": "vitest run packages/modules",
    "test:adapters": "vitest run packages/adapters",
    "test:contracts": "vitest run contract.test.ts",
    "test:http": "vitest run packages/adapters/http",
    "test:db": "vitest run packages/adapters/db",
    "test:cache": "vitest run packages/adapters/cache",
    "test:queue": "vitest run packages/adapters/queue",
    "test:email": "vitest run packages/adapters/email",
    "test:storage": "vitest run packages/adapters/storage",
    "test:analytics": "vitest run packages/adapters/analytics",
    "test:billing": "vitest run packages/adapters/billing",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:fitness && pnpm test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
