{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "paths": {
      "@plinth/core": ["../../packages/core/dist/src/index.d.ts"],
      "@plinth/core/*": ["../../packages/core/dist/src/*"],
      "@plinth/modules-brand": ["../../packages/modules/brand/dist/src/index.d.ts"],
      "@plinth/modules-brand/*": ["../../packages/modules/brand/dist/src/*"],
      "@plinth/modules-tenants": ["../../packages/modules/tenants/dist/src/index.d.ts"],
      "@plinth/modules-tenants/*": ["../../packages/modules/tenants/dist/src/*"],
      "@plinth/modules-rbac": ["../../packages/modules/rbac/dist/src/index.d.ts"],
      "@plinth/modules-rbac/*": ["../../packages/modules/rbac/dist/src/*"],
      "@plinth/modules-config-store": ["../../packages/modules/config-store/dist/src/index.d.ts"],
      "@plinth/modules-config-store/*": ["../../packages/modules/config-store/dist/src/*"],
      "@plinth/modules-audit": ["../../packages/modules/audit/dist/src/index.d.ts"],
      "@plinth/modules-audit/*": ["../../packages/modules/audit/dist/src/*"],
      "@plinth/modules-auth": ["../../packages/modules/auth/dist/src/index.d.ts"],
      "@plinth/modules-auth/*": ["../../packages/modules/auth/dist/src/*"],
      "@plinth/adapter-http-fastify": ["../../packages/adapter-http-fastify/dist/src/index.d.ts"],
      "@plinth/adapter-http-fastify/*": ["../../packages/adapter-http-fastify/dist/src/*"],
      "@plinth/adapter-db-sqlite": ["../../packages/adapter-db-sqlite/dist/src/index.d.ts"],
      "@plinth/adapter-db-sqlite/*": ["../../packages/adapter-db-sqlite/dist/src/*"],
      "@plinth/reference-api": ["./src/app.ts"],
      "@plinth/reference-api/*": ["./src/*"],
      "@/*": ["./src/*"],
      "#/*": ["./src/*"]
    }
  },
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/modules/brand" },
    { "path": "../../packages/modules/tenants" },
    { "path": "../../packages/modules/rbac" },
    { "path": "../../packages/modules/config-store" },
    { "path": "../../packages/modules/audit" },
    { "path": "../../packages/modules/auth" },
    { "path": "../../packages/adapter-http-fastify" },
    { "path": "../../packages/adapter-db-sqlite" }
  ],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
